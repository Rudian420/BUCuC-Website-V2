# Uploads only: never run scripts from this folder, even if one were uploaded by mistake.
<FilesMatch "\.(php[0-9]?|phtml|phar|pht|phps|shtml|cgi|pl|py|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

