# Live server: always HTTPS (session cookies are then always Secure). Local test hosts are skipped.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Security headers (PHP pages also send them from backend/Database/db.php)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# Never serve database dumps, logs, exports, data files, docs or tooling files to browsers.
# .json is included: no JSON file is needed publicly (members.json is read by PHP from disk).
<FilesMatch "\.(sql|log|csv|xlsx|json|md|lock|phar|bak|ini|sh|py|token)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Hide the git repository and Claude Code settings if the site is deployed with git
<IfModule mod_alias.c>
    RedirectMatch 404 /\.(git|claude)
</IfModule>
